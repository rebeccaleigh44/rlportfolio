---
// Rebecca's R + diamond mark. On hover or keyboard focus of the parent link,
// the diamond turns and the name slides out from behind the R.
const { size = 'sm' } = Astro.props as { size?: 'sm' | 'lg' };
---
<span class:list={['wordmark', `wordmark--${size}`]}>
  <svg class="mark" viewBox="0 0 37 34" aria-hidden="true" focusable="false">
    <path d="M6.71521 33.1971V8.13574H12.6995V28.0006H22.9314L26.1747 33.1971H6.71521Z" fill="currentColor"/>
    <path d="M6.71527 4.8925V0H22.7472C24.8848 0 26.7091 0.38237 28.2202 1.14711C29.7405 1.90264 30.8968 2.97604 31.6892 4.36732C32.4908 5.74938 32.8916 7.37561 32.8916 9.246C32.8916 11.1256 32.4862 12.7426 31.6753 14.097C30.8645 15.4422 29.6898 16.4742 28.1511 17.1929C26.6216 17.9115 24.7696 18.2709 22.5952 18.2709H16.0396V13.4613H21.6278C22.7703 13.4613 23.7193 13.3047 24.4748 12.9914C25.2303 12.6781 25.7924 12.2082 26.1609 11.5817C26.5387 10.9551 26.7276 10.1766 26.7276 9.246C26.7276 8.3062 26.5387 7.51381 26.1609 6.86885C25.7924 6.22389 25.2257 5.73556 24.461 5.40386C23.7055 5.06296 22.7518 4.8925 21.6001 4.8925H17.5645H6.71527ZM25.2442 15.4238L36.7152 33.2709H30.109L18.7899 15.4238H25.2442Z" fill="currentColor"/>
    <polygon class="gem" points="2.38,0 4.76,2.38 2.38,4.76 0,2.38" fill="currentColor"/>
  </svg>
  <span class="reveal" aria-hidden="true"><span class="name">rebecca leigh</span></span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    font-family: var(--serif);
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .wordmark--sm { font-size: 1.5rem; }
  .wordmark--lg { font-size: clamp(2.5rem, 6vw, 4.5rem); }
  .mark { height: 1.1em; width: auto; flex: none; overflow: visible; }
  .gem { transform-box: fill-box; transform-origin: center; transition: rotate 0.6s var(--ease); }

  /* Width animates from nothing to the name's natural width */
  .reveal {
    display: grid;
    grid-template-columns: 0fr;
    transition: grid-template-columns 0.6s var(--ease);
  }
  .name {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    padding-left: 0.45em;
    opacity: 0;
    translate: -0.6em 0;
    transition: opacity 0.35s var(--ease), translate 0.6s var(--ease);
  }

  :global(a:hover) > .wordmark .reveal,
  :global(a:focus-visible) > .wordmark .reveal { grid-template-columns: 1fr; }
  :global(a:hover) > .wordmark .name,
  :global(a:focus-visible) > .wordmark .name { opacity: 1; translate: 0 0; transition-delay: 0.08s; }
  :global(a:hover) > .wordmark .gem,
  :global(a:focus-visible) > .wordmark .gem { rotate: 90deg; }
</style>

---
import { getCollection } from 'astro:content';
import GradientField from './GradientField.astro';
import Wordmark from './Wordmark.astro';
import { site } from '../site.config';
const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="footer" id="contact">
  <GradientField variant="hills" colors={['#4f6cf2', '#f2715f', '#2d4be0', '#1b2585']} />
  <div class="wrap footer__inner">
    <div class="lead">
      <a href="/" class="home" aria-label="Rebecca Leigh, home"><Wordmark /></a>
      <p class="pitch">Have something tangled that people need to get through? I'd love to hear about it.</p>
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <nav class="cols" aria-label="Footer">
      <div>
        <h2 class="col-head">Case studies</h2>
        <ul>{work.map((w) => <li><a href={`/work/${w.id}/`}>{w.data.client}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="col-head">Elsewhere</h2>
        <ul>
          <li><a href={site.linkedin}>LinkedIn</a></li>
          <li><a href={site.resume}>Resume</a></li>
          <li><a href="/#about">About</a></li>
        </ul>
      </div>
    </nav>
    <div class="base">
      <span>&copy; {year} {site.name}</span>
      <span>Designed in Figma, built with Astro</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: clamp(14rem, 34vw, 26rem);
    background: linear-gradient(to bottom, var(--mist), #eceefb 70%);
  }
  .footer :global(.field) {
    z-index: -1;
    -webkit-mask-image: linear-gradient(to bottom, transparent 42%, #000 72%);
    mask-image: linear-gradient(to bottom, transparent 42%, #000 72%);
  }
  .footer__inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem 4rem; }
  .home { text-decoration: none; }
  .pitch {
    font-family: var(--serif);
    font-size: var(--t-lg);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-top: 1.25rem;
    max-width: 22ch;
  }
  .email { display: inline-block; margin-top: 1.25rem; font-weight: 500; }
  .cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .col-head { font-family: var(--sans); font-size: 1rem; font-weight: 600; letter-spacing: 0; margin-bottom: 0.9rem; }
  ul { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  .cols a { text-decoration: none; color: var(--ink-soft); }
  .cols a:hover { color: var(--ink); text-decoration: underline; }
  .base {
    grid-column: 1 / -1;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
    font-size: var(--t-sm);
    color: var(--ink-soft);
  }
  @media (max-width: 760px) { .footer__inner { grid-template-columns: 1fr; } }
</style>
